{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": true,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=2592000"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/journal",
      "destination": "/experiments/",
      "permanent": true
    },
    {
      "source": "/journal/",
      "destination": "/experiments/",
      "permanent": true
    },
    {
      "source": "/journal/dither-tool",
      "destination": "/experiments/dither-tool/",
      "permanent": true
    },
    {
      "source": "/journal/dither-tool/",
      "destination": "/experiments/dither-tool/",
      "permanent": true
    },
    {
      "source": "/journal/happy-diwali-3d-card",
      "destination": "/experiments/happy-diwali-3d-card/",
      "permanent": true
    },
    {
      "source": "/journal/happy-diwali-3d-card/",
      "destination": "/experiments/happy-diwali-3d-card/",
      "permanent": true
    },
    {
      "source": "/journal/diwali-isometric-motion",
      "destination": "/experiments/diwali-isometric-motion/",
      "permanent": true
    },
    {
      "source": "/journal/diwali-isometric-motion/",
      "destination": "/experiments/diwali-isometric-motion/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "thatsme-nine.vercel.app"
        }
      ],
      "destination": "https://studioshubham.vercel.app/:path*",
      "permanent": true
    }
  ],
  "installCommand": "npm ci"
}
