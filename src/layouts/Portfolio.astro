---
import HeadAssets from '../components/HeadAssets.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import Dialogs from '../components/Dialogs.astro';
import Postcard from '../components/Postcard.astro';
import data from '../data/portfolio.json';
import mobileMedia from '../data/mobile-media.json';
import { PROJECTS } from '../lib/projects.js';
import { metadata, origin } from '../lib/seo.js';
const { page, title, description, route='', project, preview=false } = Astro.props;
const { canonical, hero, graph } = metadata({page,title,description,route,project});
const base = route ? '../'.repeat(route.split('/').filter(Boolean).length) : './';
const clientData = JSON.stringify({A:data.A,M:{v:mobileMedia.videos,a:mobileMedia.anim},PROJECTS:PROJECTS.map(({id,title,desc,role,body,ownership,category})=>({id,title,desc,role,body,ownership,category}))}).replace(/</g,'\\u003c');
---
<!doctype html>
<html lang="en">
<head>
  <base href={base} />
  <HeadAssets />
  <style is:inline>html.reveal-pending #app{opacity:0}</style>
  <script is:inline>if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&'IntersectionObserver' in window){document.documentElement.classList.add('reveal-pending');setTimeout(function(){document.documentElement.classList.remove('reveal-pending')},1500)}</script>
  {preview && <meta name="robots" content="noindex,nofollow" />}
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="Shubham Shinde" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={new URL(hero,origin).href} />
  <meta property="og:image:alt" content={project?project.title+' — selected project visual':'Portrait of Shubham Shinde'} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(hero,origin).href} />
  <script is:inline type="application/ld+json" set:html={JSON.stringify({'@context':'https://schema.org','@graph':graph}).replace(/</g,'\\u003c')} />
  <noscript><style is:global>.option-enter{opacity:1!important;transform:none!important}.motion-toggle,.rail-prev,.rail-next,.filter-bar{display:none!important}.case-media-open{cursor:default}</style></noscript>
  {page==='home' && <link rel="stylesheet" href="assets/home-intro.css?v=1" />}
</head>
<body data-page={page}>
  {page==='home' && <script is:inline src="assets/home-intro.js?v=1"></script>}
  <Navigation page={page} route={route} />
  <main id="app" tabindex="-1"><slot /><Footer /></main>
  <Dialogs />
  {!preview && <Postcard />}
  <script id="portfolio-client-data" is:inline type="application/json" set:html={clientData} />
  <script>import '../scripts/interactions.js';</script>
  {!preview && process.env.VERCEL === '1' && <Fragment><script is:inline>window.va=window.va||function(){(window.vaq=window.vaq||[]).push(arguments);};</script><script is:inline defer src="/_vercel/insights/script.js"></script></Fragment>}
</body>
</html>
