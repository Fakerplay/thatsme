---
const art = [
  [1396,1506,'A purple ghost dancing under the moon'],
  [1512,1512,'Shooting your fears — skull, bats and a slingshot on yellow'],
  [1510,1506,'Last song — a singer beneath a giant microphone on yellow'],
  [1506,1512,'Tom Holland as Spider-Man, drawn in purple and pink'],
  [1510,1504,'Tobey Maguire as Spider-Man, drawn in purple and pink'],
  [1510,1510,'Andrew Garfield as Spider-Man, drawn in purple and pink'],
];
---
<section class="illustration-archive" id="illustrations" aria-labelledby="illustration-heading">
  <div class="illustration-intro">
    <h2 id="illustration-heading">5 years ago.<br />Before AI could draw, I did.</h2>
    <p>A few illustrations from the days of late nights, questionable playlists, and drawing just for the fun of it.</p>
  </div>
  <div class="illustration-window" tabindex="0" role="region" aria-roledescription="carousel" aria-label="Six original illustrations. Drag or use the left and right arrow keys to explore.">
    <div class="illustration-track">
      <div class="illustration-group">
        {art.map(([width,height,alt],i)=><div class="illustration-slot" style={`aspect-ratio:${width}/${height}`}><div class="illustration-scale"><div class="illustration-card"><img src={`/assets/illustration-archive/art-0${i+1}.webp`} width={width} height={height} alt={alt} loading="lazy" decoding="async" draggable="false" /></div></div></div>)}
      </div>
    </div>
  </div>
  <div class="illustration-bottom"><span>Hand-drawn by me. No prompts involved.</span><div class="illustration-controls" hidden><span>Drag to explore</span><button type="button" aria-label="Previous illustration" data-art-prev>←</button><button type="button" aria-label="Next illustration" data-art-next>→</button><button type="button" data-art-pause aria-pressed="false">Pause motion</button></div></div>
</section>
<style>
  :global(#app)>.illustration-archive{width:100%;max-width:none;margin:0;padding:clamp(64px,7vw,104px) 0 56px;background:#fafaf7;color:var(--ink);overflow:hidden;isolation:isolate}
  .illustration-intro,.illustration-bottom{width:calc(100% - 2 * var(--page-gutter));max-width:var(--content-max);margin-inline:auto}
  .illustration-intro{border-top:1px solid #dedfd7;padding-top:clamp(48px,6vw,88px)}
  .illustration-intro h2{font-size:clamp(34px,4.4vw,64px);line-height:1.14;letter-spacing:-.045em;margin:0;max-width:1050px}
  .illustration-intro p{max-width:590px;font-size:18px;line-height:1.6;color:var(--muted);margin:24px 0 0}
  .illustration-window{--art-height:clamp(260px,34vw,490px);--art-gap:clamp(28px,3vw,52px);position:relative;overflow-x:auto;overflow-y:hidden;padding:64px 0 52px;touch-action:pan-x pan-y;overscroll-behavior-x:contain;scrollbar-width:thin;user-select:none;-webkit-user-select:none}
  .illustration-window.is-ready{overflow:hidden;cursor:grab;touch-action:pan-y}
  .illustration-window.is-dragging{cursor:grabbing}
  .illustration-track,.illustration-group{display:flex;align-items:center;width:max-content}
  .illustration-track{position:relative}
  .is-ready .illustration-track{will-change:transform}
  .illustration-group{flex:none;gap:var(--art-gap);padding-right:var(--art-gap)}
  .illustration-slot{flex:none;height:var(--art-height);position:relative}
  .illustration-scale{width:100%;height:100%;transform:scale(var(--art-scale,1));transform-origin:center}
  .illustration-card{width:100%;height:100%;border-radius:8px;transform:perspective(1000px) translateY(var(--art-lift,0px)) rotateX(var(--art-x,0deg)) rotateY(var(--art-y,0deg));transition:transform .5s cubic-bezier(.16,1,.3,1),box-shadow .5s;overflow:hidden}
  .illustration-card img{display:block;width:100%;height:100%;object-fit:contain;pointer-events:none;-webkit-user-drag:none}
  @media(hover:hover) and (pointer:fine){.is-ready:not(.is-dragging) .illustration-slot:hover{z-index:2;--art-lift:-24px}.is-ready:not(.is-dragging) .illustration-slot:hover .illustration-card{box-shadow:0 20px 30px -15px #24262044}}
  .illustration-bottom{display:flex;align-items:center;justify-content:space-between;gap:20px;font-size:12px;color:var(--muted)}
  .illustration-controls{display:flex;align-items:center;gap:10px}
  .illustration-controls[hidden]{display:none}
  :global(html:not(#art-a#art-b#art-c#art-d)) .illustration-controls button{font:inherit;color:var(--ink)!important;border:1px solid #c9cbc1!important;border-radius:999px!important;background:transparent!important;box-shadow:none!important;letter-spacing:0!important;min-height:44px;min-width:44px;padding:10px 14px;cursor:pointer}
  :global(html:not(#art-a#art-b#art-c#art-d)) .illustration-controls button:hover{background:#e9ece3!important;box-shadow:none!important;transform:none!important}
  .illustration-window:focus-visible,.illustration-controls button:focus-visible{outline:2px solid var(--ink);outline-offset:-3px}
  @media(max-width:700px){.illustration-window{--art-height:clamp(245px,70vw,340px);--art-gap:28px;padding-block:48px 36px}.illustration-intro p{font-size:16px}.illustration-bottom{align-items:flex-start;flex-direction:column;gap:16px}.illustration-controls{width:100%}.illustration-controls>span{margin-right:auto}}
  @media(prefers-reduced-motion:reduce){.illustration-card{transform:none!important;transition:none;box-shadow:none!important}.illustration-scale{transform:none}}
</style>
<script>import '../scripts/illustration-archive.js';</script>
