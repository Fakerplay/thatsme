---
import Portfolio from '../layouts/Portfolio.astro';
import {origin} from '../lib/seo.js';
const {slug,title,description,shareImage,shareAlt,published='2026-11-09',keywords=[],projectUrl,projectLabel,ctaText='Open the tool'}=Astro.props;
const canonical=new URL(`journal/${slug}/`,origin).href;
const imageUrl=new URL(shareImage,origin).href;
const linkedInShare='https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(canonical);
const xShare='https://twitter.com/intent/tweet?text='+encodeURIComponent(title+' — a design and AI-making note by Shubham Shinde')+'&url='+encodeURIComponent(canonical);
const structuredData={
  '@type':'BlogPosting',
  '@id':canonical+'#article',
  headline:title,
  description,
  image:[imageUrl],
  datePublished:published,
  dateModified:published,
  author:{'@id':new URL('#person',origin).href},
  publisher:{'@id':new URL('#person',origin).href},
  mainEntityOfPage:{'@type':'WebPage','@id':canonical},
  isPartOf:{'@type':'Blog','@id':new URL('journal/',origin).href+'#journal','name':'Notes on design and making'},
  keywords,
  inLanguage:'en',
  about:[{'@type':'Thing','name':'AI-assisted design'},{'@type':'Thing','name':'Creative technology'}]
};
---
<Portfolio page="journal" route={`journal/${slug}/`} title={title+' — Shubham Shinde'} description={description} socialImage={shareImage} socialImageAlt={shareAlt} structuredData={structuredData}>
  <article class="journal-article">
    <header class="journal-header">
      <a class="journal-back" href="/journal/">Journal <span aria-hidden="true">↗</span></a>
      <p class="journal-eyebrow">A Diwali vacation experiment · Bengaluru, India</p>
      <h1>{title}</h1>
      <p class="journal-deck">{description}</p>
      <dl class="journal-byline">
        <div><dt>Made by</dt><dd><a href="/about/">Shubham Shinde</a></dd></div>
        <div><dt>Practice</dt><dd>Design direction · creative technology · AI-assisted making</dd></div>
        <div><dt>Published</dt><dd><time datetime={published}>{new Date(published+'T12:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'})}</time></dd></div>
      </dl>
    </header>
    <div class="journal-body">
      <slot />
      <aside class="journal-try" aria-label="Try the project">
        <div><span class="journal-eyebrow">Made with AI · Directed by me</span><h2>{projectLabel}</h2></div>
        <a class="btn" href={projectUrl} target={projectUrl.startsWith('http')?'_blank':undefined} rel={projectUrl.startsWith('http')?'noopener noreferrer':undefined}><span class="btn-label">{ctaText}</span></a>
      </aside>
      <nav class="journal-related" aria-label="Related writing">
        <a href="/journal/diwali-isometric-motion/">Diwali isometric motion</a>
        <a href="/journal/dither-tool/">Dither tool</a>
        <a href="/journal/happy-diwali-3d-card/">3D Diwali greeting</a>
      </nav>
      <nav class="journal-share" aria-label="Share this article"><span>Pass it along:</span><a href={linkedInShare} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={xShare} target="_blank" rel="noopener noreferrer">X ↗</a></nav>
      <p class="journal-return"><a href="/experiments/">Browse all experiments</a> <span aria-hidden="true">↗</span></p>
    </div>
  </article>
</Portfolio>
<style>

.journal-article{--journal-width:960px;color:var(--ink,#141512)}
.journal-header{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);max-width:1560px;margin:auto;padding:clamp(48px,7vw,90px) var(--pad) 0;border-bottom:1px solid var(--line)}
.journal-back{display:inline-flex;gap:8px;color:var(--muted);text-decoration:none;font-size:.9rem}.journal-back:hover{text-decoration:underline}
.journal-eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;color:var(--muted);margin:0 0 18px}
.journal-header>.journal-back{grid-column:1/-1;border-bottom:1px solid var(--line);padding-bottom:16px;margin-bottom:0}
.journal-header>.journal-eyebrow{grid-column:1;grid-row:2/5;align-self:start;margin:0;padding:26px 22px 28px 0}
.journal-header h1{grid-column:2;grid-row:2;max-width:15ch;font-size:clamp(48px,7.2vw,96px);line-height:.94;letter-spacing:-.065em;margin:0;padding:24px 0 0 clamp(24px,5vw,72px);border-left:1px solid var(--line)}
.journal-deck{grid-column:2;grid-row:3;font-size:clamp(19px,2vw,25px);line-height:1.45;max-width:720px;color:var(--muted);margin:24px 0 30px;padding-left:clamp(24px,5vw,72px);border-left:1px solid var(--line)}
.journal-byline{grid-column:2;grid-row:4;display:flex;flex-wrap:wrap;gap:12px clamp(20px,3vw,42px);border-top:1px solid var(--line);border-left:1px solid var(--line);padding:16px 0 24px clamp(24px,5vw,72px);margin:0}.journal-byline div{display:grid;gap:5px}.journal-byline dt{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.journal-byline dd{margin:0;font-size:.9rem}.journal-byline a{color:inherit}
.journal-body{max-width:1560px;margin:auto;padding:0 var(--pad) 100px}.journal-body> :global(*){box-sizing:border-box}
.journal-body :global(.journal-media){margin:0 0 clamp(42px,7vw,84px);overflow:hidden;background:var(--surface);border:1px solid var(--line);border-radius:2px}.journal-body :global(.journal-media video),.journal-body :global(.journal-media img){display:block;width:100%;height:auto;max-height:none;object-fit:contain}.journal-body :global(.journal-media video){aspect-ratio:16/9}.journal-body :global(.journal-media img){max-height:82vh}.journal-body :global(.journal-media figcaption){display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);border-top:1px solid var(--line);padding:12px 0;color:var(--muted);font-size:.82rem}.journal-body :global(.journal-media figcaption)::before{content:'SHOWCASE / 01';padding:0 14px;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em}
.journal-try{display:flex;justify-content:space-between;align-items:center;gap:28px;max-width:var(--journal-width);margin:70px auto 36px;padding:28px 0;border-block:1px solid var(--line)}.journal-try .journal-eyebrow{margin-bottom:10px}.journal-try h2{font-size:clamp(24px,3vw,34px);margin:0;letter-spacing:-.04em}.journal-try .btn{flex:0 0 auto}.journal-related{max-width:var(--journal-width);margin:0 auto;display:flex;flex-wrap:wrap;gap:10px 22px;padding:18px 0;border-bottom:1px solid var(--line)}.journal-related a,.journal-return a{color:inherit;text-underline-offset:4px}.journal-related a{font-size:.9rem}.journal-share{max-width:var(--journal-width);margin:18px auto;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;color:var(--muted);font-size:.86rem}.journal-share a{color:var(--ink);text-underline-offset:4px}.journal-return{max-width:var(--journal-width);margin:24px auto;color:var(--muted)}
@media(max-width:760px){.journal-header{grid-template-columns:1fr;padding-top:42px}.journal-header>.journal-back{grid-column:1}.journal-header>.journal-eyebrow{grid-column:1;grid-row:auto;padding:24px 0 12px}.journal-header h1,.journal-deck,.journal-byline{grid-column:1;grid-row:auto;border-left:0;padding-left:0}.journal-header h1{padding-top:0;font-size:clamp(44px,11vw,72px)}.journal-deck{margin:20px 0 24px}.journal-byline{gap:16px 24px}.journal-byline div:last-child{display:none}.journal-body :global(.journal-media figcaption){grid-template-columns:1fr;gap:6px;padding-inline:12px}.journal-body :global(.journal-media figcaption)::before{padding:0}.journal-try{align-items:flex-start;flex-direction:column}}

.journal-body{counter-reset:journal-section}
</style>
<style is:global>
/* Article body is slotted from each page, so its styles must be global to apply */
.journal-copy{max-width:var(--journal-width);margin:0 auto 64px;border-inline:1px solid var(--line);padding:0 clamp(18px,3vw,42px)}.journal-copy h2{display:grid;grid-template-columns:minmax(120px,.65fr) minmax(0,1.35fr);font-size:clamp(30px,4.2vw,48px);line-height:1.08;letter-spacing:-.045em;margin:58px 0 20px;padding-top:24px;border-top:1px solid var(--line)}.journal-copy h2::before{counter-increment:journal-section;content:counter(journal-section,decimal-leading-zero) ' /';font-size:.68rem;font-weight:400;letter-spacing:.1em;color:var(--muted);padding:8px 16px 0 0}.journal-copy h3{font-size:1.35rem;line-height:1.2;margin:34px 0 12px}.journal-copy p,.journal-copy li{font-size:clamp(17px,1.6vw,20px);line-height:1.68;color:#44463f}.journal-copy p{margin:0 0 20px}.journal-copy h2~p,.journal-copy h2~ul{margin-left:32.5%}.journal-copy a{color:inherit;text-decoration-thickness:1px;text-underline-offset:4px}.journal-copy ul{padding-left:1.2em}.journal-copy li+li{margin-top:8px}
.journal-facts{border:1px solid var(--line);padding:0;margin:34px 0 42px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0}.journal-facts div{display:grid;gap:7px;padding:20px;border-right:1px solid var(--line);border-bottom:1px solid var(--line)}.journal-facts div:nth-child(2n){border-right:0}.journal-facts div:nth-last-child(-n+2){border-bottom:0}.journal-facts dt{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.journal-facts dd{margin:0;line-height:1.5}
.journal-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0;margin:40px 0 64px;border:1px solid var(--line)}.journal-gallery figure{margin:0;background:var(--surface);border-right:1px solid var(--line)}.journal-gallery figure:last-child{border-right:0}.journal-gallery img{display:block;width:100%;height:auto;max-height:60vh;object-fit:contain}.journal-gallery figcaption{border-top:1px solid var(--line);padding:10px 12px;color:var(--muted);font-size:.8rem}
@media(max-width:760px){.journal-copy{padding:0 14px}.journal-copy h2{grid-template-columns:1fr;gap:12px;margin-top:42px}.journal-copy h2::before{padding:0}.journal-copy h2~p,.journal-copy h2~ul{margin-left:0}.journal-facts{grid-template-columns:1fr}.journal-facts div,.journal-facts div:nth-child(2n),.journal-facts div:nth-last-child(-n+2){border-right:0;border-bottom:1px solid var(--line)}.journal-facts div:last-child{border-bottom:0}.journal-gallery{grid-template-columns:1fr}.journal-gallery figure,.journal-gallery figure:last-child{border-right:0;border-bottom:1px solid var(--line)}.journal-gallery figure:last-child{border-bottom:0}}
/* tool imagery inside articles */
.journal-window{max-width:1200px;margin:0 auto 64px}
.journal-window a{display:block;overflow:hidden;border-radius:10px;background:#0c0c0c;border:1px solid #1d1d1b;box-shadow:0 24px 60px -32px rgba(20,21,18,.45)}
.journal-window .jw-bar{display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-bottom:1px solid #1f1f1d;color:#9a9a92;font-size:.74rem}
.journal-window .jw-bar i{width:9px;height:9px;border-radius:50%;background:#2c2c29}
.journal-window .jw-bar span{margin-left:10px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.7rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.journal-window .jw-bar b{margin-left:auto;font-weight:400;display:inline-flex;align-items:center;gap:7px;padding:3px 9px;border:1px solid #2c2c29;border-radius:20px;color:#d6d6cf;white-space:nowrap}
.journal-window .jw-bar b::before{content:'';width:6px;height:6px;border-radius:50%;background:#7bd88f}
#app .journal-window img{display:block;width:100%;height:auto;border-radius:0}
.journal-window figcaption,.journal-presets figcaption{display:grid;grid-template-columns:minmax(120px,.3fr) minmax(0,1fr);gap:16px;padding:14px 0 0;color:var(--muted);font-size:.86rem;line-height:1.5}
.journal-window figcaption em,.journal-presets figcaption em{font-style:normal;font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;padding-top:2px}
.journal-presets{max-width:1200px;margin:0 auto 64px}
.journal-presets ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px}
#app .journal-presets img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:6px;background:#0c0c0c}
.journal-presets li span{display:grid;gap:2px;padding-top:9px;font-size:.78rem;color:var(--muted)}
.journal-presets li b{font-weight:400;color:var(--ink);font-size:.88rem}
@media(max-width:760px){.journal-window,.journal-presets{margin-bottom:44px}.journal-window .jw-bar{height:32px}.journal-presets ul{grid-template-columns:repeat(2,minmax(0,1fr))}.journal-window figcaption,.journal-presets figcaption{grid-template-columns:1fr;gap:6px}}
</style>
