---
import Portfolio from '../layouts/Portfolio.astro';
import {origin} from '../lib/seo.js';
const {slug,title,description,shareImage,shareAlt,published='2026-11-09',keywords=[],projectUrl,projectLabel,ctaText='Open the tool'}=Astro.props;
const canonical=new URL(`journal/${slug}/`,origin).href;
const imageUrl=new URL(shareImage,origin).href;
const linkedInShare='https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(canonical);
const xShare='https://twitter.com/intent/tweet?text='+encodeURIComponent(title+' — a design and AI-making note by Shubham Shinde')+'&url='+encodeURIComponent(canonical);
const structuredData={
  '@type':'BlogPosting',
  '@id':canonical+'#article',
  headline:title,
  description,
  image:[imageUrl],
  datePublished:published,
  dateModified:published,
  author:{'@id':new URL('#person',origin).href},
  publisher:{'@id':new URL('#person',origin).href},
  mainEntityOfPage:{'@type':'WebPage','@id':canonical},
  isPartOf:{'@type':'Blog','@id':new URL('journal/',origin).href+'#journal','name':'Notes on design and making'},
  keywords,
  inLanguage:'en',
  about:[{'@type':'Thing','name':'AI-assisted design'},{'@type':'Thing','name':'Creative technology'}]
};
---
<Portfolio page="journal" route={`journal/${slug}/`} title={title+' — Shubham Shinde'} description={description} socialImage={shareImage} socialImageAlt={shareAlt} structuredData={structuredData}>
  <article class="journal-article">
    <div class="case-index-layout journal-layout">
      <aside class="case-index-info">
        <a class="case-index-back" href="/journal/">Journal</a>
        <h1>{title}</h1>
        <p>{description}</p>
        <dl>
          <dt>Made by</dt><dd><a href="/about/">Shubham Shinde</a></dd>
          <dt>Practice</dt><dd>Design direction, creative technology &amp; AI-assisted making</dd>
          <dt>Published</dt><dd><time datetime={published}>{new Date(published+'T12:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'})}</time></dd>
        </dl>
        <p class="case-index-context">A Diwali vacation experiment · Bengaluru, India</p>
        <nav class="case-index-links" aria-label="Project links">
          <a class="case-index-primary" href={projectUrl} target={projectUrl.startsWith('http')?'_blank':undefined} rel={projectUrl.startsWith('http')?'noopener noreferrer':undefined}>{ctaText} ↗</a>
        </nav>
        <p class="case-index-context journal-share">Share: <a href={linkedInShare} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a> · <a href={xShare} target="_blank" rel="noopener noreferrer">X ↗</a></p>
      </aside>
      <div class="journal-body">
        <slot />
        <nav class="journal-related" aria-label="More from the Journal">
          <span>More from the Journal</span>
          <a href="/journal/diwali-isometric-motion/">Diwali effects ↗</a>
          <a href="/journal/dither-tool/">Dither Boil ↗</a>
          <a href="/journal/happy-diwali-3d-card/">3D Diwali greeting ↗</a>
          <a href="/experiments/">All experiments ↗</a>
        </nav>
      </div>
    </div>
  </article>
</Portfolio>
<style is:global>
/* Journal articles use the case-study layout: sticky info column + media column (see assets/case-index.css) */
body[data-page="journal"] .case-index-layout{display:grid;grid-template-columns:minmax(220px,26%) minmax(0,1fr);gap:5vw;padding:56px 0 0;align-items:start;margin-inline:4vw}
body[data-page="journal"] .case-index-info{max-height:none;overflow:visible}
body[data-page="journal"] .case-index-info .journal-share{margin-top:18px}.journal-share a{color:inherit}
.journal-body{min-width:0;padding-bottom:96px}
.journal-body>*+*{margin-top:20px}
.journal-media,.journal-window,.journal-presets,.journal-gallery{margin:0}
.journal-media img,.journal-media video,.journal-window img,.journal-gallery img{display:block;width:100%;height:auto;border-radius:16px;background:var(--surface,#eceae4)}
.journal-media video{aspect-ratio:16/9;background:#000}
.journal-window a{display:block;border-radius:16px;overflow:hidden}
.journal-window .jw-bar{display:none}
.journal-media figcaption,.journal-window figcaption,.journal-presets figcaption,.journal-gallery figcaption{padding-top:12px;font-size:12px;line-height:1.5;color:var(--muted)}
.journal-window figcaption em,.journal-presets figcaption em{display:none}
.journal-presets ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:12px}
.journal-presets img{display:block;width:100%;height:auto;aspect-ratio:1/1;object-fit:cover;border-radius:12px;background:#000}
.journal-presets li span{display:block;padding-top:8px;font-size:12px;color:var(--muted)}
.journal-presets li b{display:block;font-weight:400;color:var(--ink);font-size:13px}
.journal-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px;align-items:start;margin:32px 0 40px!important}
body[data-page="journal"] .journal-copy .journal-gallery{margin:36px 0 44px!important}
.journal-gallery figure{margin:0}
.journal-copy{max-width:760px;padding-block:36px 28px}
.journal-copy h2{font-size:clamp(28px,3.4vw,44px);line-height:1.15;letter-spacing:-.04em;font-weight:400;margin:24px 0 20px}
.journal-copy p,.journal-copy li{font-size:17px;line-height:1.7;color:#44463f}
.journal-copy p{margin:0 0 18px}
.journal-copy a{color:inherit;text-decoration-thickness:1px;text-underline-offset:4px}
.journal-facts{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 32px;margin:32px 0 8px;padding:24px 0;border-block:1px solid var(--line)}
.journal-facts div{display:grid;gap:6px}
.journal-facts dt{font-size:13px;color:#62645d}
.journal-facts dd{margin:0;font-size:15px;line-height:1.55}
.journal-related{display:flex;flex-wrap:wrap;align-items:center;gap:10px 24px;margin-top:56px!important;padding-top:28px;border-top:1px solid var(--line);font-size:14px}
.journal-related span{color:var(--muted);margin-right:auto;flex-basis:100%}
.journal-related a{color:inherit;text-underline-offset:4px}
@media(max-width:800px){body[data-page="journal"] .case-index-layout{display:block;padding-top:32px;margin-inline:4vw}.journal-presets ul{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:600px){body[data-page="journal"] .case-index-layout{margin-inline:18px}.journal-gallery,.journal-facts{grid-template-columns:1fr}.journal-copy{padding-top:28px}}
</style>
