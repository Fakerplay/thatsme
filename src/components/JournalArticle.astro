---
import Portfolio from '../layouts/Portfolio.astro';
import {origin} from '../lib/seo.js';
const {slug,title,description,shareImage,shareAlt,published='2026-11-09',keywords=[],projectUrl,projectLabel,ctaText='Open the tool'}=Astro.props;
const canonical=new URL(`journal/${slug}/`,origin).href;
const imageUrl=new URL(shareImage,origin).href;
const linkedInShare='https://www.linkedin.com/sharing/share-offsite/?url='+encodeURIComponent(canonical);
const xShare='https://twitter.com/intent/tweet?text='+encodeURIComponent(title+' — a design and AI-making note by Shubham Shinde')+'&url='+encodeURIComponent(canonical);
const structuredData={
  '@type':'BlogPosting',
  '@id':canonical+'#article',
  headline:title,
  description,
  image:[imageUrl],
  datePublished:published,
  dateModified:published,
  author:{'@id':new URL('#person',origin).href},
  publisher:{'@id':new URL('#person',origin).href},
  mainEntityOfPage:{'@type':'WebPage','@id':canonical},
  isPartOf:{'@type':'Blog','@id':new URL('journal/',origin).href+'#journal','name':'Notes on design and making'},
  keywords,
  inLanguage:'en',
  about:[{'@type':'Thing','name':'AI-assisted design'},{'@type':'Thing','name':'Creative technology'}]
};
---
<Portfolio page="journal" route={`journal/${slug}/`} title={title+' — Shubham Shinde'} description={description} socialImage={shareImage} socialImageAlt={shareAlt} structuredData={structuredData}>
  <article class="journal-article">
    <header class="journal-header">
      <a class="journal-back" href="/journal/">Journal <span aria-hidden="true">↗</span></a>
      <p class="journal-eyebrow">A Diwali vacation experiment · Bengaluru, India</p>
      <h1>{title}</h1>
      <p class="journal-deck">{description}</p>
      <dl class="journal-byline">
        <div><dt>Made by</dt><dd><a href="/about/">Shubham Shinde</a></dd></div>
        <div><dt>Practice</dt><dd>Design direction · creative technology · AI-assisted making</dd></div>
        <div><dt>Published</dt><dd><time datetime={published}>{new Date(published+'T12:00:00').toLocaleDateString('en-IN',{day:'numeric',month:'long',year:'numeric'})}</time></dd></div>
      </dl>
    </header>
    <div class="journal-body">
      <slot />
      <aside class="journal-try" aria-label="Try the project">
        <div><span class="journal-eyebrow">Made with AI · Directed by me</span><h2>{projectLabel}</h2></div>
        <a class="btn" href={projectUrl} target={projectUrl.startsWith('http')?'_blank':undefined} rel={projectUrl.startsWith('http')?'noopener noreferrer':undefined}><span class="btn-label">{ctaText}</span></a>
      </aside>
      <nav class="journal-related" aria-label="Related writing">
        <a href="/journal/diwali-isometric-motion/">Diwali isometric motion</a>
        <a href="/journal/dither-tool/">Dither tool</a>
        <a href="/journal/happy-diwali-3d-card/">3D Diwali greeting</a>
      </nav>
      <nav class="journal-share" aria-label="Share this article"><span>Pass it along:</span><a href={linkedInShare} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a><a href={xShare} target="_blank" rel="noopener noreferrer">X ↗</a></nav>
      <p class="journal-return"><a href="/experiments/">Browse all experiments</a> <span aria-hidden="true">↗</span></p>
    </div>
  </article>
</Portfolio>
<style>
.journal-article{--journal-width:760px;color:var(--ink,#141512)}
.journal-header{padding:clamp(54px,9vw,118px) var(--pad) clamp(42px,6vw,76px);max-width:1240px;margin:auto}
.journal-back{display:inline-flex;gap:8px;color:var(--muted);text-decoration:none;font-size:.9rem}.journal-back:hover{text-decoration:underline}
.journal-eyebrow{text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;color:var(--muted);margin:0 0 18px}
.journal-header>.journal-eyebrow{margin-top:clamp(56px,8vw,110px)}
.journal-header h1{max-width:14ch;font-size:clamp(48px,8vw,104px);line-height:.98;letter-spacing:-.065em;margin:0}
.journal-deck{font-size:clamp(19px,2vw,25px);line-height:1.45;max-width:720px;color:var(--muted);margin:28px 0 34px}
.journal-byline{display:flex;flex-wrap:wrap;gap:12px 40px;border-top:1px solid var(--line);padding-top:16px;margin:0}.journal-byline div{display:grid;gap:5px}.journal-byline dt{color:var(--muted);font-size:.72rem;text-transform:uppercase;letter-spacing:.08em}.journal-byline dd{margin:0;font-size:.9rem}.journal-byline a{color:inherit}
.journal-body{max-width:1240px;margin:auto;padding:0 var(--pad) 100px}.journal-body> :global(*){box-sizing:border-box}
.journal-body :global(.journal-media){margin:0 0 clamp(42px,7vw,84px);overflow:hidden;background:#101112;border-radius:4px}.journal-body :global(.journal-media video),.journal-body :global(.journal-media img){display:block;width:100%;height:auto;max-height:78vh;object-fit:contain}.journal-body :global(.journal-media figcaption){padding:12px 16px;color:#777;font-size:.82rem}
.journal-copy{max-width:var(--journal-width);margin:0 auto 64px}.journal-copy h2{font-size:clamp(30px,4.2vw,48px);line-height:1.08;letter-spacing:-.045em;margin:58px 0 20px}.journal-copy h3{font-size:1.35rem;line-height:1.2;margin:34px 0 12px}.journal-copy p,.journal-copy li{font-size:clamp(17px,1.6vw,20px);line-height:1.68;color:#44463f}.journal-copy p{margin:0 0 20px}.journal-copy a{color:inherit;text-decoration-thickness:1px;text-underline-offset:4px}.journal-copy ul{padding-left:1.2em}.journal-copy li+li{margin-top:8px}
.journal-facts{border-block:1px solid var(--line);padding:22px 0;margin:34px 0 42px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:22px 36px}.journal-facts div{display:grid;gap:7px}.journal-facts dt{font-size:.72rem;text-transform:uppercase;letter-spacing:.08em;color:var(--muted)}.journal-facts dd{margin:0;line-height:1.5}
.journal-gallery{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px;margin:40px 0 64px}.journal-gallery figure{margin:0;background:#121212}.journal-gallery img{display:block;width:100%;height:auto}.journal-gallery figcaption{padding:10px 12px;color:var(--muted);font-size:.8rem}
.journal-try{display:flex;justify-content:space-between;align-items:center;gap:28px;max-width:var(--journal-width);margin:70px auto 36px;padding:28px 0;border-block:1px solid var(--line)}.journal-try .journal-eyebrow{margin-bottom:10px}.journal-try h2{font-size:clamp(24px,3vw,34px);margin:0;letter-spacing:-.04em}.journal-try .btn{flex:0 0 auto}.journal-related{max-width:var(--journal-width);margin:0 auto;display:flex;flex-wrap:wrap;gap:10px 22px;padding:18px 0;border-bottom:1px solid var(--line)}.journal-related a,.journal-return a{color:inherit;text-underline-offset:4px}.journal-related a{font-size:.9rem}.journal-share{max-width:var(--journal-width);margin:18px auto;display:flex;flex-wrap:wrap;gap:8px 16px;align-items:center;color:var(--muted);font-size:.86rem}.journal-share a{color:var(--ink);text-underline-offset:4px}.journal-return{max-width:var(--journal-width);margin:24px auto;color:var(--muted)}
@media(max-width:640px){.journal-byline{gap:16px 24px}.journal-byline div:last-child{display:none}.journal-facts{grid-template-columns:1fr;gap:16px}.journal-gallery{grid-template-columns:1fr}.journal-try{align-items:flex-start;flex-direction:column}.journal-body :global(.journal-media video){max-height:none}}
</style>
