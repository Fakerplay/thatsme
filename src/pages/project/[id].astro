---
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import {getCaseStudy} from '../../lib/storyblok.js';
import Portfolio from '../../layouts/Portfolio.astro';
import {PROJECTS} from '../../lib/projects.js';
import {projectPage,projectSummary} from '../../lib/render.js';
import {companyLinks} from '../../lib/links.js';
export function getStaticPaths(){return PROJECTS.map(project=>({params:{id:project.id},props:{project}}));}
const {project:localProject}=Astro.props;
const story=await getCaseStudy(localProject.id);
const project=story?{...localProject,title:story.content.title,summary:story.content.summary,role:story.content.role}:localProject;
---
<Portfolio page="project" route={'project/'+project.id+'/'} project={project} title={project.title+' — '+project.type+' | Shubham Shinde'} description={projectSummary(project)}>{story ? <StoryblokComponent blok={story.content} /> : <Fragment set:html={companyLinks(projectPage(project))} />}</Portfolio>
