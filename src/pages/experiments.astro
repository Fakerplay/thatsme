---
import Portfolio from '../layouts/Portfolio.astro';
const tools = [
  {
    id: 'dither-boil', num: '01', kicker: 'Image to motion', title: 'Dither Boil',
    lede: 'Upload an image or clip, shape its animated 1-bit grain, and export a loop.',
    specs: [['Input', 'Image or video clip'], ['Output', 'PNG still or looping video'], ['Runs on', 'Canvas, in the browser']],
    url: 'experiments/dither-boil/', host: 'studioshubham.vercel.app/experiments/dither-boil', cta: 'Try the tool', story: 'journal/dither-tool/',
    window: { src: 'assets/experiments/dither-boil-ui.jpg', w: 2400, h: 1500, alt: 'The Dither Boil tool: an archer artwork boiling as white 1-bit grain, with presets, pattern and tone controls in the side panel' },
    stripLabel: 'One source, four presets',
    strip: [
      ['assets/experiments/dither-preset-boil.jpg', 'Boil', 'Random dashes, every frame'],
      ['assets/experiments/dither-preset-ordered.jpg', 'Ordered', 'Bayer grid, retro print'],
      ['assets/experiments/dither-preset-diffusion.jpg', 'Diffusion', 'Soft, detailed grain'],
      ['assets/experiments/dither-preset-hard-cut.jpg', 'Hard cut', 'High contrast, slow boil'],
    ],
  },
  {
    id: 'happy-diwali-3d', num: '02', kicker: 'Personalised greeting', title: 'Happy Diwali, in 3D',
    lede: 'A greeting you can explore, flip and personalise. Drag the objects, switch day and night, then write your own message.',
    specs: [['Built with', 'Three.js + GLTF models'], ['Models', 'Generated with Tripo'], ['Saves', 'Your names and message']],
    url: 'experiments/happy-diwali-3d/', host: 'studioshubham.vercel.app/experiments/happy-diwali-3d', cta: 'Try the tool', story: 'journal/happy-diwali-3d-card/',
    window: { src: 'assets/experiments/diwali-3d-ui.jpg', w: 1440, h: 900, alt: 'The live Happy Diwali 3D greeting: giant greeting type, diyas, hanging kandils, marigolds and lotuses, with home and card controls' },
    stripLabel: 'Scenes and models',
    strip: [
      ['assets/journal/diwali/greeting-night.jpg', 'Night', 'Tap the sky for fireworks'],
      ['assets/journal/diwali/greeting-day.jpg', 'Day', 'Same scene, morning light'],
      ['experiments/happy-diwali-3d/assets/scene-orbit.png', 'Orbit', 'Turn the whole scene'],
    ],
  },
  {
    id: 'diwali-effects', num: '03', kicker: 'Festival effects', title: 'Diwali effects',
    lede: 'Five familiar forms (diya, anar, chakri, kandil and kamal), each on its own island with a colour and a moment of movement.',
    specs: [['Showcase', '14-second isometric film'], ['Objects', 'Diya · anar · chakri · kandil · kamal'], ['Made', 'From my concept, built with AI']],
    url: 'journal/diwali-isometric-motion/', host: 'Showcase film · Diwali effects', cta: 'View the showcase', story: 'journal/diwali-isometric-motion/',
    video: { src: 'assets/journal/diwali/kandil-motion.mp4', poster: 'assets/journal/diwali/kandil-poster.jpg', alt: 'Showcase film: a diya, anar, chakri, kandil and kamal glowing on a dark isometric grid' },
  },
];
---
<Portfolio page="experiments" route="experiments/" title="Experiments — Interactive tools by Shubham Shinde" description="Interactive tools, creative coding and visual experiments by Shubham Shinde, design lead and art director in Bengaluru, India.">
  <section class="page-intro experiments-intro">
    <div class="experiments-intro-label">Custom tools · Made with AI</div>
    <div>
      <h1>Experiments</h1>
      <p>Tools built from my concepts, with a look inside each one and what it can make.</p>
      <ol class="xp-index" aria-label="Tools on this page">
        {tools.map((t) => <li><a href={`#${t.id}`}><span>{t.num}</span>{t.title}<em>{t.kicker}</em></a></li>)}
      </ol>
    </div>
  </section>

  <section class="xp-list" aria-label="Custom AI-built tools and their showcases">
    {tools.map((t) => (
      <article class="xp" id={t.id}>
        <div class="xp-meta">
          <p class="xp-kicker">{t.num} / {t.kicker}</p>
          <h2>{t.title}</h2>
          <p class="xp-lede">{t.lede}</p>
          <dl class="xp-specs">{t.specs.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          <div class="xp-links">
            <a class="pill" href={t.url}>{t.cta} <span aria-hidden="true">↗</span></a>
            <a class="text-link" href={t.story}>Tool + showcase story</a>
          </div>
        </div>

        <div class="xp-media">
          <a class="xp-window" href={t.url} aria-label={`Open ${t.title}`}>
            <span class="xp-bar" aria-hidden="true"><i></i><i></i><i></i><span class="xp-url">{t.host}</span><span class="xp-live">{t.video ? 'Film' : 'Live tool'}</span></span>
            {t.window && <img src={t.window.src} alt={t.window.alt} width={t.window.w} height={t.window.h} loading="lazy" decoding="async" />}
            {t.video && <video class="xp-video" autoplay muted loop playsinline preload="metadata" poster={t.video.poster} aria-label={t.video.alt}><source src={t.video.src} type="video/mp4" /></video>}
          </a>
          {t.strip && (
            <figure class="xp-strip" style={`--cols:${t.strip.length};--ratio:${t.strip.length === 4 ? '1/1' : '16/10'}`}>
              <figcaption>{t.stripLabel}</figcaption>
              <ul>
                {t.strip.map(([src, name, note]) => (
                  <li><img src={src} alt={`${t.title}: ${name}. ${note}`} loading="lazy" decoding="async" /><span><b>{name}</b>{note}</span></li>
                ))}
              </ul>
            </figure>
          )}
        </div>
      </article>
    ))}
  </section>
  <p class="journal-invite">More process notes and project stories live in the <a href="journal/">Journal ↗</a>.</p>
</Portfolio>
<style>
.experiments-intro{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);max-width:1560px;margin:auto;padding-bottom:48px;border-bottom:1px solid var(--line)}
.experiments-intro-label{padding:8px 24px 0 0;text-transform:uppercase;letter-spacing:.1em;font-size:.72rem;color:var(--muted)}
.experiments-intro>div+div{border-left:1px solid var(--line);padding-left:clamp(24px,5vw,72px)}
.experiments-intro h1{margin:0}
.experiments-intro>div+div>p{max-width:600px;margin-bottom:0}
.xp-index{list-style:none;margin:36px 0 0;padding:0;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));border-top:1px solid var(--line)}
.xp-index li+li{border-left:1px solid var(--line)}
.xp-index a{display:grid;gap:6px;padding:16px 18px 4px 0;color:inherit;text-decoration:none;font-size:1.02rem;letter-spacing:-.02em}
.xp-index li+li a{padding-left:18px}
.xp-index span{font-size:.7rem;letter-spacing:.1em;color:var(--muted)}
.xp-index em{font-style:normal;font-size:.8rem;color:var(--muted);letter-spacing:0}
.xp-index a:hover{text-decoration:underline;text-underline-offset:4px}

.xp-list{max-width:1560px;margin:auto;padding:0 var(--pad) 56px}
.xp{display:grid;grid-template-columns:minmax(260px,.65fr) minmax(0,1.35fr);border-bottom:1px solid var(--line);scroll-margin-top:90px}
.xp-meta{padding:clamp(28px,4vw,56px) clamp(20px,3vw,44px) clamp(28px,4vw,56px) 0;border-right:1px solid var(--line)}
.xp-meta>*{position:relative}
@media(min-width:761px){.xp-meta{position:sticky;top:80px;align-self:start}}
.xp-kicker{font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 18px}
.xp h2{font-size:clamp(36px,4.2vw,64px);line-height:.98;letter-spacing:-.055em;margin:0 0 18px}
.xp-lede{max-width:420px;margin:0 0 26px;color:var(--muted);line-height:1.55}
.xp-specs{margin:0;border-top:1px solid var(--line)}
.xp-specs div{display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;padding:11px 0;border-bottom:1px solid var(--line);font-size:.88rem}
.xp-specs dt{font-size:.68rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);padding-top:2px}
.xp-specs dd{margin:0}
.xp-links{display:flex;flex-wrap:wrap;align-items:center;gap:18px;margin-top:26px}
.xp-links .pill{margin-top:0}
.xp-links .text-link{color:inherit;text-decoration-thickness:1px;text-underline-offset:4px;font-size:.92rem}

.xp-media{min-width:0;padding:clamp(28px,4vw,56px) 0 clamp(28px,4vw,56px) clamp(20px,3vw,44px);display:grid;gap:clamp(18px,2vw,28px)}
.xp-window{display:block;min-width:0;overflow:hidden;border-radius:10px;background:#0c0c0c;border:1px solid #1d1d1b;box-shadow:0 1px 0 rgba(255,255,255,.04) inset,0 24px 60px -32px rgba(20,21,18,.45);transition:transform .35s cubic-bezier(.2,.8,.2,1),box-shadow .35s}
.xp-window:hover{transform:translateY(-3px);box-shadow:0 1px 0 rgba(255,255,255,.04) inset,0 34px 70px -34px rgba(20,21,18,.55)}
.xp-window:focus-visible{outline:2px solid var(--ink);outline-offset:4px}
.xp-bar{display:flex;align-items:center;gap:7px;height:38px;padding:0 14px;border-bottom:1px solid #1f1f1d;color:#9a9a92;font-size:.74rem}
.xp-bar i{width:9px;height:9px;border-radius:50%;background:#2c2c29;flex:0 0 auto}
.xp-url{margin-left:10px;font-family:'JetBrains Mono',ui-monospace,monospace;font-size:.7rem;letter-spacing:.01em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;min-width:0}
.xp-live{margin-left:auto;flex:0 0 auto;display:inline-flex;align-items:center;gap:7px;padding:3px 9px;border:1px solid #2c2c29;border-radius:20px;color:#d6d6cf}
.xp-live::before{content:'';width:6px;height:6px;border-radius:50%;background:#7bd88f}
:global(#app) .xp-window img,:global(#app) .xp-window video{display:block;width:100%;height:auto;aspect-ratio:16/10;object-fit:cover;object-position:top center;border-radius:0;background:#0c0c0c}
:global(#app) .xp-window video{aspect-ratio:16/9}

.xp-strip{margin:0}
.xp-strip figcaption{font-size:.68rem;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 12px}
.xp-strip ul{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:clamp(10px,1.2vw,16px)}
.xp-strip li{min-width:0}
:global(#app) .xp-strip img{display:block;width:100%;height:auto;aspect-ratio:var(--ratio,1/1);object-fit:cover;border-radius:6px;background:#0c0c0c}
.xp-strip li span{display:grid;gap:2px;padding-top:9px;font-size:.78rem;color:var(--muted);line-height:1.35}
.xp-strip b{font-weight:400;color:var(--ink);font-size:.86rem}
.journal-invite{padding:0 var(--pad) 100px;text-align:center;color:var(--muted)}
.journal-invite a{color:var(--ink)}

@media(max-width:1100px){.xp{grid-template-columns:minmax(220px,.8fr) minmax(0,1.2fr)}}
@media(max-width:760px){
  .experiments-intro{grid-template-columns:1fr;gap:18px;padding-top:42px;padding-bottom:32px}
  .experiments-intro-label{padding:0}
  .experiments-intro>div+div{border-left:0;padding-left:0}
  .xp-index{grid-template-columns:1fr}.xp-index li+li{border-left:0;border-top:1px solid var(--line)}.xp-index li+li a,.xp-index a{padding:12px 0}
  .xp{grid-template-columns:1fr}
  .xp-meta{border-right:0;padding:32px 0 8px}
  .xp-media{padding:16px 0 36px}
  .xp-bar{height:32px}.xp-bar i{width:7px;height:7px}
  .xp-strip[style*="--cols:4"] ul{grid-template-columns:repeat(2,minmax(0,1fr))}
}
@media(prefers-reduced-motion:reduce){.xp-window{transition:none}.xp-window:hover{transform:none}}
</style>
<script>
const reduce=matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll('.xp-video').forEach((v)=>{if(!(v instanceof HTMLVideoElement))return;const sync=()=>{if(reduce.matches){v.pause();v.removeAttribute('autoplay')}else v.play().catch(()=>{})};sync();reduce.addEventListener('change',sync)});
</script>
