---
import Portfolio from '../layouts/Portfolio.astro';

// Same building blocks as the Work page: page-intro, project-row, row-heading, project-tags and a moving natural rail.
const icons = {
  tool: '<path d="M3 4h18v16H3zm2 5v9h14V9z" fill-rule="evenodd"/><circle cx="6" cy="6.5" r=".75" fill="var(--tag-surface)"/><circle cx="9" cy="6.5" r=".75" fill="var(--tag-surface)"/>',
  motion: '<path d="M3 5h18v14H3zm7 3v8l6-4z" fill-rule="evenodd"/>',
  cube: '<path d="M12 2 3 7v10l9 5 9-5V7zm0 2.3L18.7 8 12 11.7 5.3 8zM5 9.7l6 3.3v6.6l-6-3.3zm8 9.9V13l6-3.3v6.6z" fill-rule="evenodd"/>',
  ai: '<path d="M11 2h2l1.6 5.4L20 9v2l-5.4 1.6L13 18h-2l-1.6-5.4L4 11V9l5.4-1.6zM18 15h2l.7 2.3L23 18v1l-2.3.7L20 22h-2l-.7-2.3L15 19v-1l2.3-.7z"/>',
};
const tools = [
  {
    id: 'dither-boil', title: 'Dither Boil', url: 'experiments/dither-boil/', story: '/experiments/dither-tool/', cta: 'Try the tool',
    desc: 'A browser tool I designed for turning an image or video clip into animated 1-bit grain. Pick a preset, shape the texture, export a loop.',
    tags: [['tool', 'Web tool'], ['motion', 'Motion'], ['ai', 'Built with AI']],
    shots: [
      { src: 'assets/experiments/dither-card-ui.jpg', w: 2400, h: 1500, alt: 'The Dither Boil tool turning the archer artwork into soft Diffusion grain, with presets and tone controls on the right', label: 'The tool' },
      { video: 'experiments/dither-boil/preview.mp4', poster: 'experiments/dither-boil/preview.jpg', w: 720, h: 720, alt: 'A looping archer animation exported from Dither Boil', label: 'Exported loop' },
      { src: 'assets/experiments/dither-card-warm.jpg', w: 900, h: 900, alt: 'The archer as glowing orange dashes on near-black, using the Boil preset with high glow', label: 'Ember colour pair' },
    ],
  },
  {
    id: 'happy-diwali-3d', title: 'Happy Diwali, in 3D', url: 'experiments/happy-diwali-3d/', story: '/experiments/happy-diwali-3d-card/', cta: 'Try the tool',
    desc: 'An interactive 3D greeting you can explore, flip and personalise. Drag the diyas and flowers, switch day and night, then write your own message.',
    tags: [['cube', '3D'], ['tool', 'Web tool'], ['ai', 'Built with AI']],
    shots: [
      { src: 'assets/experiments/diwali-3d-ui.jpg', w: 1440, h: 900, alt: 'The live Happy Diwali 3D greeting with diyas, kandils, marigolds and lotuses', label: 'The live scene' },
      { src: 'assets/experiments/diwali-card-kandil.jpg', w: 900, h: 900, alt: 'A 3D kandil lantern model generated with Tripo', label: 'Kandil model' },
      { src: 'assets/experiments/diwali-card-lotus.jpg', w: 900, h: 900, alt: 'A 3D lotus model generated with Tripo', label: 'Lotus model' },
    ],
  },
  {
    id: 'diwali-effects', title: 'Diwali effects', url: '/experiments/diwali-isometric-motion/', cta: 'View the showcase',
    desc: 'A Diwali effects experience built around five familiar forms (diya, anar, chakri, kandil and kamal), shown through an isometric motion film.',
    tags: [['motion', 'Motion'], ['cube', '3D'], ['ai', 'Built with AI']],
    shots: [
      { video: 'assets/journal/diwali/kandil-motion.mp4', poster: 'assets/journal/diwali/kandil-poster.jpg', w: 1920, h: 1080, alt: 'Showcase film of the Diwali effects experience', label: 'Showcase film' },
      { src: 'assets/experiments/effects-card-anar.jpg', w: 900, h: 900, alt: 'The anar effect: green sparks rising from its island', label: 'Anar' },
      { src: 'assets/experiments/effects-card-kamal.jpg', w: 900, h: 900, alt: 'The kamal effect: pink lotus petals opening', label: 'Kamal' },
    ],
  },
];
---
<Portfolio page="experiments" route="experiments/" title="Experiments — Interactive tools by Shubham Shinde" description="Interactive tools, creative coding and visual experiments by Shubham Shinde, design lead and art director in Bengaluru, India.">
  <section class="page-intro"><h1>Experiments</h1><p>Tools I’ve designed and built with AI, and what each one can make.</p></section>
  {tools.map((t) => (
    <section class="xp-row" aria-labelledby={`row-${t.id}`}>
      <div class="row-heading">
        <h2 class="project-row-heading"><a href={t.url} class="row-title" id={`row-${t.id}`}>{t.title}</a></h2>
        <p>{t.desc}</p>
        <div class="project-tags">
          {t.tags.map(([icon, label]) => (
            <span class="project-tag"><svg class="project-tag__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={icons[icon]} /><span>{label}</span></span>
          ))}
        </div>
        <nav class="case-index-links xp-links" aria-label={`${t.title} links`}>
          <a class="case-index-primary" href={t.url}>{t.cta} ↗</a>
          {t.story && <a class="case-index-secondary" href={t.story}>Case study</a>}
        </nav>
      </div>
      <div class="xp-shots">
        {t.shots.map((s) => (
          <a class="xp-shot" style={`--r:${(s.w / s.h).toFixed(4)}`} href={t.url} aria-label={`Open ${t.title}: ${s.label}`}>
            {s.video
              ? <video src={s.video} poster={s.poster} aria-label={s.alt} muted loop playsinline autoplay preload="metadata"></video>
              : <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" />}
            <span>{s.label}</span>
          </a>
        ))}
      </div>
    </section>
  ))}
</Portfolio>
<style>
.xp-row{padding:clamp(56px,8vw,112px) var(--pad) 0;max-width:1560px;margin:0 auto}
.xp-row+.xp-row{margin-top:clamp(24px,4vw,56px);border-top:1px solid var(--line)}
.xp-row .row-heading{max-width:640px;display:grid;gap:18px;margin-bottom:clamp(28px,4vw,44px)}
.xp-row .row-heading p{margin:0;color:var(--muted);line-height:1.6}
.xp-row .project-row-heading{margin:0}
.xp-links{margin-top:6px}
.case-index-secondary{display:inline-flex;justify-content:center;align-items:center;border:1px solid #22201b;border-radius:999px;padding:15px 25px;font-size:15px;line-height:1.4;color:#22201b;text-decoration:none}
.case-index-secondary:hover{background:#22201b0a}
.case-index-secondary:focus-visible{outline:2px solid currentColor;outline-offset:4px}
/* justified row: each shot grows by its aspect ratio so all three share one height */
.xp-shots{display:flex;gap:clamp(10px,1.4vw,20px);align-items:flex-start}
.xp-shot{flex:var(--r) 1 0;min-width:0;display:grid;gap:10px;color:var(--muted);text-decoration:none;font-size:13px}
:global(#app) .xp-shot img,:global(#app) .xp-shot video{display:block;width:100%;height:auto;aspect-ratio:var(--r);object-fit:cover;border-radius:14px;background:#0c0c0c;transition:transform .5s cubic-bezier(.22,1,.36,1)}
.xp-shot:hover img,.xp-shot:hover video{transform:scale(1.012)}
.xp-shot:focus-visible{outline:2px solid var(--ink);outline-offset:4px;border-radius:14px}
.xp-end{margin:clamp(72px,9vw,120px) var(--pad) 0}
@media(max-width:900px){
  .xp-shots{flex-wrap:wrap}
  .xp-shot:first-child{flex-basis:100%}
  .xp-shot:not(:first-child){flex:1 1 0}
}
@media(prefers-reduced-motion:reduce){.xp-shot img,.xp-shot video{transition:none}}
</style>
<script>
const reduce=matchMedia('(prefers-reduced-motion: reduce)');
document.querySelectorAll('.xp-shot video').forEach((v)=>{if(!(v instanceof HTMLVideoElement))return;const sync=()=>{if(reduce.matches){v.pause();v.removeAttribute('autoplay')}else v.play().catch(()=>{})};sync();reduce.addEventListener('change',sync)});
</script>
