---
import Portfolio from '../layouts/Portfolio.astro';

// Same building blocks as the Work page: page-intro, project-row, row-heading, project-tags and a moving natural rail.
const icons = {
  tool: '<path d="M3 4h18v16H3zm2 5v9h14V9z" fill-rule="evenodd"/><circle cx="6" cy="6.5" r=".75" fill="var(--tag-surface)"/><circle cx="9" cy="6.5" r=".75" fill="var(--tag-surface)"/>',
  motion: '<path d="M3 5h18v14H3zm7 3v8l6-4z" fill-rule="evenodd"/>',
  cube: '<path d="M12 2 3 7v10l9 5 9-5V7zm0 2.3L18.7 8 12 11.7 5.3 8zM5 9.7l6 3.3v6.6l-6-3.3zm8 9.9V13l6-3.3v6.6z" fill-rule="evenodd"/>',
  ai: '<path d="M11 2h2l1.6 5.4L20 9v2l-5.4 1.6L13 18h-2l-1.6-5.4L4 11V9l5.4-1.6zM18 15h2l.7 2.3L23 18v1l-2.3.7L20 22h-2l-.7-2.3L15 19v-1l2.3-.7z"/>',
};
const tools = [
  {
    id: 'dither-boil', title: 'Dither Boil', url: 'experiments/dither-boil/', story: 'journal/dither-tool/', cta: 'Try the tool',
    desc: 'A browser tool I designed for turning an image or video clip into animated 1-bit grain. Pick a preset, shape the texture, export a loop.',
    tags: [['tool', 'Web tool'], ['motion', 'Motion'], ['ai', 'Built with AI']],
    slides: [
      { src: 'assets/experiments/dither-boil-ui.jpg', w: 2400, h: 1500, alt: 'The Dither Boil tool with an archer artwork boiling as white grain, and presets, pattern and tone controls' },
      { video: 'experiments/dither-boil/preview.mp4', poster: 'experiments/dither-boil/preview.jpg', w: 720, h: 720, alt: 'A loop exported from Dither Boil' },
      { src: 'assets/experiments/dither-preset-boil.jpg', w: 900, h: 900, alt: 'Boil preset: random dashes, every frame' },
      { src: 'assets/experiments/dither-preset-ordered.jpg', w: 900, h: 900, alt: 'Ordered preset: Bayer grid, retro print' },
      { src: 'assets/experiments/dither-preset-diffusion.jpg', w: 900, h: 900, alt: 'Diffusion preset: soft, detailed grain' },
      { src: 'assets/experiments/dither-preset-hard-cut.jpg', w: 900, h: 900, alt: 'Hard cut preset: high contrast, slow boil' },
      { src: 'assets/experiments/dither-boil-ui-warm.jpg', w: 2400, h: 1500, alt: 'Dither Boil with a warm ink and paper colour pair on a studio portrait' },
    ],
  },
  {
    id: 'happy-diwali-3d', title: 'Happy Diwali, in 3D', url: 'experiments/happy-diwali-3d/', story: 'journal/happy-diwali-3d-card/', cta: 'Try the tool',
    desc: 'An interactive 3D greeting you can explore, flip and personalise. Drag the diyas and flowers, switch day and night, then write your own message.',
    tags: [['cube', '3D'], ['tool', 'Web tool'], ['ai', 'Built with AI']],
    slides: [
      { src: 'assets/experiments/diwali-3d-ui.jpg', w: 1440, h: 900, alt: 'The live Happy Diwali 3D greeting with home and card controls' },
      { src: 'assets/journal/diwali/greeting-night.jpg', w: 1100, h: 690, alt: 'Night scene with fireworks' },
      { src: 'assets/journal/diwali/greeting-day.jpg', w: 1100, h: 690, alt: 'Day scene' },
      { src: 'experiments/happy-diwali-3d/assets/scene-orbit.png', w: 1000, h: 625, alt: 'The scene turned on its orbit' },
    ],
  },
  {
    id: 'diwali-effects', title: 'Diwali effects', url: 'journal/diwali-isometric-motion/', story: 'journal/diwali-isometric-motion/', cta: 'View the showcase',
    desc: 'A Diwali effects experience built around five familiar forms (diya, anar, chakri, kandil and kamal), shown through an isometric motion film.',
    tags: [['motion', 'Motion'], ['cube', '3D'], ['ai', 'Built with AI']],
    slides: [
      { video: 'assets/journal/diwali/kandil-motion.mp4', poster: 'assets/journal/diwali/kandil-poster.jpg', w: 1920, h: 1080, alt: 'Showcase film of the Diwali effects experience' },
      { src: 'assets/journal/diwali/kandil-poster.jpg', w: 1920, h: 1080, alt: 'Diya, anar, chakri, kandil and kamal on a dark isometric grid' },
    ],
  },
];
---
<Portfolio page="experiments" route="experiments/" title="Experiments — Interactive tools by Shubham Shinde" description="Interactive tools, creative coding and visual experiments by Shubham Shinde, design lead and art director in Bengaluru, India.">
  <section class="page-intro"><h1>Experiments</h1><p>Tools I’ve designed and built with AI, and what each one can make.</p></section>
  {tools.map((t) => (
    <section class="project-row xp-row" aria-labelledby={`row-${t.id}`}>
      <div class="row-heading">
        <h2 class="project-row-heading"><a href={t.url} class="row-title" id={`row-${t.id}`}>{t.title}</a></h2>
        <p>{t.desc}</p>
        <div class="project-tags">
          {t.tags.map(([icon, label]) => (
            <span class="project-tag"><svg class="project-tag__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false" set:html={icons[icon]} /><span>{label}</span></span>
          ))}
        </div>
        <nav class="case-index-links xp-links" aria-label={`${t.title} links`}>
          <a class="case-index-primary" href={t.url}>{t.cta} ↗</a>
          <a class="case-index-secondary" href={t.story}>Tool + showcase story</a>
        </nav>
      </div>
      <div class="rail natural-rail" data-moving tabindex="0" role="region" aria-label={`${t.title} gallery`}>
        {t.slides.map((s) => (
          <a class="art-slide" style={`--image-ratio:${s.w / s.h};--native-width:${s.w}px`} href={t.url} aria-label={`Open ${t.title} — ${s.alt}`}>
            {s.video
              ? <video width={s.w} height={s.h} src={s.video} poster={s.poster} aria-label={s.alt} muted loop playsinline preload="none" draggable="false"></video>
              : <img src={s.src} alt={s.alt} width={s.w} height={s.h} loading="lazy" decoding="async" draggable="false" />}
          </a>
        ))}
      </div>
    </section>
  ))}
  <section class="case-index-end xp-end"><p>More process notes and project stories live in the Journal.</p><a href="journal/">Read the Journal</a></section>
</Portfolio>
<style>
.xp-links{margin-top:24px}
.case-index-secondary{display:inline-flex;justify-content:center;align-items:center;border:1px solid #22201b;border-radius:999px;padding:15px 25px;font-size:15px;line-height:1.4;color:#22201b;text-decoration:none}
.case-index-secondary:hover{background:#22201b0a}
.case-index-secondary:focus-visible{outline:2px solid currentColor;outline-offset:4px}
.xp-end{margin-inline:var(--pad)}
</style>
