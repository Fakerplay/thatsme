---
import Portfolio from '../../layouts/Portfolio.astro';
const entries=[
 {title:'A Diwali effects tool, with a little festival in it',desc:'A custom AI-built Diwali experience, directed by me and shown through an isometric motion showcase.',href:'/journal/diwali-isometric-motion/',image:'assets/journal/diwali/kandil-poster.jpg',alt:'A glowing Diwali diya, anar, chakri, kandil and kamal arranged on a dark isometric grid'},
 {title:'Dither Boil: an AI-built tool for restless images',desc:'A personalised browser tool built from my concept prompt, with a real output showcase and controls for shaping the loop.',href:'/journal/dither-tool/',image:'assets/journal/diwali/dither-poster.jpg',alt:'An archer image rendered as animated black-and-white dither grain'},
 {title:'An AI-built 3D Diwali greeting you can make your own',desc:'A custom greeting tool built from my concept, shown through day and night scenes and an interactive flip-card showcase.',href:'/journal/happy-diwali-3d-card/',image:'assets/journal/diwali/greeting-night.jpg',alt:'Interactive Happy Diwali greeting scene with marigolds, lotuses, kandils and diyas'},
];
const description='Independent notes on design, AI-assisted creative technology and hands-on making by Shubham Shinde, design lead and art director in Bengaluru, India.';
---
<Portfolio page="journal" route="journal/" title="Journal — Design, AI & Creative Technology | Shubham Shinde" description={description}>
  <section class="page-intro journal-index-intro"><p class="journal-index-kicker">Notes from the studio and the spare hours</p><h1>Journal</h1><p>Custom tools I built with AI from my own concepts, plus a look at what they can make. I bring the idea and art direction; AI helps turn it into something people can use.</p></section>
  <section class="journal-index" aria-label="Journal articles">
    {entries.map((entry,i)=><article class="journal-card">
      <a class="journal-card-art" href={entry.href}><img src={entry.image} alt={entry.alt} loading={i===0?'eager':'lazy'} width="1200" height="675"><span>Read the story ↗</span></a>
      <div class="journal-card-copy"><p class="journal-card-kicker">Diwali · Design + making</p><h2><a href={entry.href}>{entry.title}</a></h2><p>{entry.desc}</p><a class="journal-card-link" href={entry.href}>Read article <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </section>
</Portfolio>
<style>
.journal-index-intro{max-width:1280px;margin:auto}.journal-index-kicker{font-size:.76rem!important;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:0 0 18px!important}.journal-index-intro h1{font-size:clamp(58px,11vw,150px);line-height:.9;letter-spacing:-.08em;margin:0}.journal-index-intro>p:last-child{max-width:620px}
.journal-index{padding:0 var(--pad) 110px;max-width:1560px;margin:auto;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:clamp(34px,5vw,76px) 24px}.journal-card:first-child{grid-column:1/-1;display:grid;grid-template-columns:1.4fr .8fr;align-items:end;gap:clamp(24px,5vw,72px)}.journal-card-art{position:relative;display:block;overflow:hidden;background:#121212;aspect-ratio:16/9}.journal-card-art img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .7s cubic-bezier(.22,1,.36,1)}.journal-card-art:hover img{transform:scale(1.025)}.journal-card-art>span{position:absolute;right:14px;bottom:14px;padding:8px 12px;background:var(--paper);border-radius:999px;color:var(--ink);font-size:.82rem}.journal-card-copy{padding-top:18px}.journal-card-kicker{font-size:.73rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);margin:0 0 14px}.journal-card h2{font-size:clamp(25px,3vw,42px);line-height:1.08;letter-spacing:-.045em;margin:0 0 14px}.journal-card h2 a{color:inherit;text-decoration:none}.journal-card h2 a:hover{text-decoration:underline;text-underline-offset:5px}.journal-card-copy>p:not(.journal-card-kicker){max-width:520px;color:var(--muted);line-height:1.55}.journal-card-link{display:inline-flex;gap:8px;margin-top:12px;color:inherit;text-decoration:none}.journal-card-link:hover{text-decoration:underline;text-underline-offset:4px}
@media(max-width:760px){.journal-index{grid-template-columns:1fr}.journal-card:first-child{grid-column:auto;display:block}.journal-card h2{font-size:clamp(28px,8vw,40px)}}
</style>
