---
import Portfolio from '../../layouts/Portfolio.astro';
const entries=[
 {title:'Dither Boil: an AI-built tool for restless images',desc:'A personalised browser tool built from my concept prompt, with a real output showcase and controls for shaping the loop.',href:'/journal/dither-tool/',image:'assets/journal/diwali/dither-poster.jpg',alt:'An archer image rendered as animated black-and-white dither grain'},
];
const description='Independent notes on design, AI-assisted creative technology and hands-on making by Shubham Shinde, design lead and art director in Bengaluru, India.';
---
<Portfolio page="journal" route="journal/" title="Journal — Design, AI & Creative Technology | Shubham Shinde" description={description}>
  <section class="page-intro journal-index-intro"><p class="journal-index-kicker">Custom tools · Made with AI</p><h1>Journal</h1><p>Stories behind the tools: the idea, how I shaped it, and a closer look at what it can make.</p></section>
  <section class="journal-index" aria-label="Journal articles">
    {entries.map((entry,i)=><article class="journal-card">
      <a class="journal-card-art" href={entry.href}><img src={entry.image} alt={entry.alt} loading={i===0?'eager':'lazy'} width="1200" height="675"><span>Read the story ↗</span></a>
      <div class="journal-card-copy"><p class="journal-card-kicker">Diwali · Design + making</p><h2><a href={entry.href}>{entry.title}</a></h2><p>{entry.desc}</p><a class="journal-card-link" href={entry.href}>Read article <span aria-hidden="true">↗</span></a></div>
    </article>)}
  </section>
</Portfolio>
<style>
.journal-index-intro{display:grid;grid-template-columns:minmax(180px,.65fr) minmax(0,1.35fr);gap:0;max-width:1560px;margin:auto;padding-bottom:48px;border-bottom:1px solid var(--line)}.journal-index-kicker{grid-row:1/3;font-size:.72rem!important;text-transform:uppercase;letter-spacing:.1em;color:var(--muted);margin:8px 24px 0 0!important}.journal-index-intro h1{grid-column:2;font-size:clamp(58px,9vw,124px);line-height:.9;letter-spacing:-.08em;margin:0;padding-left:clamp(24px,5vw,72px);border-left:1px solid var(--line)}.journal-index-intro>p:last-child{grid-column:2;max-width:620px;padding-left:clamp(24px,5vw,72px);margin-top:22px;margin-bottom:0}
.journal-index{padding:0 var(--pad) 110px;max-width:1560px;margin:auto;display:grid;grid-template-columns:1fr;border-top:1px solid var(--line)}.journal-card,.journal-card:first-child{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(280px,.75fr);align-items:stretch;gap:0;border-bottom:1px solid var(--line)}.journal-card-art{position:relative;display:grid;place-items:center;overflow:hidden;background:var(--surface);min-height:360px;aspect-ratio:16/8.5;padding:0;border-right:1px solid var(--line)}.journal-card-art img{display:block;width:100%;height:100%;object-fit:contain;transition:transform .7s cubic-bezier(.22,1,.36,1)}.journal-card-art:hover img{transform:scale(1.015)}.journal-card-art>span{position:absolute;right:14px;bottom:14px;padding:8px 12px;background:var(--paper);border:1px solid var(--line);border-radius:999px;color:var(--ink);font-size:.82rem}.journal-card-copy{align-self:center;padding:clamp(24px,4vw,54px)}.journal-card-kicker{font-size:.73rem;text-transform:uppercase;letter-spacing:.09em;color:var(--muted);margin:0 0 14px}.journal-card h2{font-size:clamp(28px,3.7vw,46px);line-height:1.03;letter-spacing:-.05em;margin:0 0 14px}.journal-card h2 a{color:inherit;text-decoration:none}.journal-card h2 a:hover{text-decoration:underline;text-underline-offset:5px}.journal-card-copy>p:not(.journal-card-kicker){max-width:520px;color:var(--muted);line-height:1.55}.journal-card-link{display:inline-flex;gap:8px;margin-top:12px;color:inherit;text-decoration:none}.journal-card-link:hover{text-decoration:underline;text-underline-offset:4px}
@media(max-width:760px){.journal-index-intro{grid-template-columns:1fr;gap:16px;padding-top:42px;padding-bottom:32px}.journal-index-kicker{grid-row:auto;margin:0!important}.journal-index-intro h1,.journal-index-intro>p:last-child{grid-column:1;padding-left:0;border-left:0}.journal-index-intro>p:last-child{margin-top:6px}.journal-card,.journal-card:first-child{grid-template-columns:1fr}.journal-card-art{min-height:0;aspect-ratio:16/9;border-right:0;border-bottom:1px solid var(--line)}.journal-card-copy{padding:24px 4px 30px}.journal-card h2{font-size:clamp(28px,8vw,40px)}}
</style>
