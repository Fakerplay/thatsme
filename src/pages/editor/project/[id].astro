---
export const prerender=false;
import StoryblokComponent from '@storyblok/astro/StoryblokComponent.astro';
import Portfolio from '../../../layouts/Portfolio.astro';
import {PROJECTS} from '../../../lib/projects.js';
import {validPreview} from '../../../lib/preview-auth.js';
const token=process.env.STORYBLOK_PREVIEW_TOKEN || import.meta.env.STORYBLOK_PREVIEW_TOKEN;
const space=process.env.STORYBLOK_SPACE_ID || import.meta.env.STORYBLOK_SPACE_ID;
Astro.response.headers.set('Cache-Control','private, no-store');
Astro.response.headers.set('X-Robots-Tag','noindex, nofollow');
Astro.response.headers.set('Referrer-Policy','no-referrer');
Astro.response.headers.set('Content-Security-Policy',"frame-ancestors 'self' https://app.storyblok.com");
if(!validPreview(Astro.url,token,space)) return new Response('Open this preview from the Storyblok Visual Editor.',{status:401,headers:Astro.response.headers});
const project=PROJECTS.find(p=>p.id===Astro.params.id);
if(!project)return new Response('Project not found',{status:404});
let story;
if(Astro.request.method==='POST') {
 const text=await Astro.request.text();
 if(text.length>2000000)return new Response('Preview too large',{status:413});
 try{story=JSON.parse(text).story;}catch{return new Response('Invalid preview',{status:400});}
} else {
 const response=await fetch(`https://api.storyblok.com/v2/cdn/stories/project/${project.id}?version=draft&token=${encodeURIComponent(token)}&cv=${Date.now()}`);
 if(!response.ok)return new Response('Preview content unavailable',{status:502});
 story=(await response.json()).story;
}
if(story?.full_slug!==`project/${project.id}`||story?.content?.component!=='case_study')return new Response('Invalid case study',{status:400});
---
<Portfolio page="project" route={'editor/project/'+project.id+'/'} project={project} title={'Preview: '+story.content.title} description={story.content.summary} preview={true}>
 <div id="storyblok-preview"><StoryblokComponent blok={story.content} /></div>
</Portfolio>
<script>
import {loadStoryblokBridge} from '@storyblok/astro';
loadStoryblokBridge().then(()=>{
 const bridge=new window.StoryblokBridge();
 let timer,controller;
 bridge.on(['published','change'],()=>location.reload());
 bridge.on('input',event=>{
  clearTimeout(timer);
  timer=setTimeout(async()=>{
   controller?.abort();controller=new AbortController();
   try {
    const response=await fetch(location.href,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({story:event.story}),signal:controller.signal});
    if(!response.ok)return;
    const doc=new DOMParser().parseFromString(await response.text(),'text/html');
    const next=doc.querySelector('#storyblok-preview');
    if(next){document.querySelector('#storyblok-preview').replaceWith(next);next.querySelectorAll('video').forEach(video=>video.load());}
   } catch(error){if(error.name!=='AbortError')console.warn('Preview update unavailable. Save to refresh.');}
  },180);
 });
});
</script>
<style is:global>
body:has(#storyblok-preview) .portfolio-note{display:none!important}
#storyblok-preview .option-enter{opacity:1!important;filter:none!important;transform:none!important;clip-path:none!important}
</style>
